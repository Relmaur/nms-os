  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Relmaur/nms-os.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/Relmaur/nms-os/blob/main/docs/mcp.md",
  "keywords": [
    "no-mans-sky",
    "mcp",
    "model-context-protocol",
    "claude",
    "nms"
  ],
  "bin": {
