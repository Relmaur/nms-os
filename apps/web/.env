# The sync relay (apps/sync, ADR-0005). Its workers.dev address isn't secret: every copy it stores is encrypted on the
# player's device. Empty means the build has no Sync group (Export and Import still move the log).
VITE_SYNC_URL=https://atlas-sync.nms-os.workers.dev
