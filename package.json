{
  "name": "nms-os",
  "version": "3.0.0",
  "private": true,
  "description": "ATLAS // MASTER OS — local-first No Man's Sky companion with an offline mirror of the wiki's game data",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "sync:wiki": "node scripts/sync-wiki.mjs",
    "verify:wiki": "node scripts/sync-wiki.mjs --verify",
    "index:wiki": "node scripts/sync-wiki.mjs --index-only",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
