{
  "name": "nms-os",
  "version": "3.9.0",
  "private": true,
  "description": "ATLAS // MASTER OS — local-first No Man's Sky companion with an offline mirror of the wiki's game data",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm --filter @atlas/web build",
    "preview": "pnpm --filter @atlas/web preview",
    "start": "pnpm dev",
    "sync:wiki": "node packages/wiki/src/sync.ts",
    "verify:wiki": "node packages/wiki/src/sync.ts --verify",
    "index:wiki": "node packages/wiki/src/sync.ts --index-only",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web && tsc -p apps/web/src/sw && tsc -p apps/sync",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @atlas/web build --mode e2e && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
