{
  "name": "nms-os",
  "version": "2.0.0",
  "private": true,
  "description": "ATLAS // MASTER OS \u2014 local-first No Man's Sky companion with an offline mirror of the wiki's game data",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "sync:wiki": "node scripts/sync-wiki.mjs",
    "verify:wiki": "node scripts/sync-wiki.mjs --verify",
    "index:wiki": "node scripts/sync-wiki.mjs --index-only",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
