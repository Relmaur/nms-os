{
  "name": "nms-os",
  "version": "2.0.0",
  "private": true,
  "description": "ATLAS // MASTER OS — local-first No Man's Sky companion with an offline Markdown wiki",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "npx serve .",
    "sync:wiki": "node scripts/sync-wiki.mjs",
    "seed:wiki": "node scripts/sync-wiki.mjs --seed-only",
    "index:wiki": "node scripts/sync-wiki.mjs --index-only"
  }
}
